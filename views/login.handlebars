<!--Login page -->
<div class="flex justify-center text-xs h-full">
    <div class="flex flex-col mt-20">
    {{#if error}}
    <p class="mb-6 bg-red-100 p-2 border border-red-300 rounded-sm text-red-700">{{error}}</p>
    {{/if}}

    <!--Login form-->
    <form class="bg-white flex flex-col w-[400px] h-auto p-6 " action="/login" method="post">
        
        <!--Username field -->
        <label class="font-bold pb-2"
            for="username"> Username</label> 
        
        <input class="border pl-3 p-1"
            type="text" id="username" name="username" placeholder="Username" value="{{username}}"> 

        <!--Password field -->
        <label class="font-bold pb-2 mt-3"
            for="password"> Password </label> 
       
        <input class="border pl-3 p-1"
            type="password" id="password" name="password" placeholder="******************"> 

        <!--Submit login button-->
        <button class="bg-teal-500 text-white mt-6 p-2 pl-4 pr-4 self-start rounded-sm font-bold"
            type="submit"> Sign In </button>

    </form>
 
     </div>
</div>