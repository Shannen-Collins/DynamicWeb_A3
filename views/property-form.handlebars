<!-- Add or Edit Property form -->
<div class="p-10 flex justify-center text-sm">
<div class="bg-white p-6 pl-12 pr-12 w-[500px]">
<!-- Property form header, for add or edit -->
<h2 class="text-2xl font-bold pb-5 text-center">{{heading}}</h2>

<!-- Error display -->
{{#if errors}}
<div>
    <ul class="mb-6 bg-red-100 p-2 border border-red-300 rounded-sm text-red-700">
        {{#each errors}}
        <li>{{this}}</li>
        {{/each}}
    </ul>
</div>
{{/if}}

<!-- From for adding or editing properties -->
<form action="{{action}}" method="post" enctype="multipart/form-data"
        class="flex flex-col ">

    <!--Address field -->
    <label for="address">Address</label>
    <input type="text" id="address" name="address" value="{{property.address}}"
        class="border mb-3" >

    <!--Suburb field -->
    <label for="suburb">Suburb</label>
    <select id="suburb" name="suburb" class="border mb-3" >
        <option value="">Choose a suburb</option>
        {{#each suburbOptions}}
        <option value="{{this.name}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
    </select>

    <!--Town / City field -->
    <label for="townCity">Town / City</label>
    <input class="border mb-3" type="text" id="townCity" name="townCity" 
    value="{{property.townCity}}" >

    <!--List price field -->
    <label for="listPrice">List Price ($)</label>
    <input class="border mb-3" type="number" id="listPrice" name="listPrice" 
    value="{{property.listPrice}}" >

    <!--Bedrooms field -->
    <label for="bedrooms">Bedrooms</label>
    <input class="border mb-3" type="number" id="bedrooms" name="bedrooms" 
    value="{{property.bedrooms}}" >

    <!--Description field -->
    <label for="description">Description</label>
    <textarea id="description" name="description" rows="4" 
        class="border mb-3">{{property.description}}</textarea>

    <!--Checkboxes -->
   <div class="grid grid-cols-2 pb-4 pt-4">
    <label>
        <!--Ensuite field -->
        <input type="checkbox" name="ensuite" value="1"
            {{#if property.ensuite}}checked{{/if}}>
            Ensuite
    </label>
    <label>
        <!--Pool field -->
        <input type="checkbox" name="pool" value="1"
            {{#if property.pool}}checked{{/if}}>
            Pool
    </label>
    <label>
        <!--Featured field -->
        <input type="checkbox" name="featured" value="1"
            {{#if property.featured}}checked{{/if}}>
            Featured
    </label>
    <label> 
        <!--Sold field -->
        <input type="checkbox" name="sold" value="1"
            {{#if property.sold}}checked{{/if}}>
            Sold
    </label>
    <label>
        <!--Active field -->
        <input type="checkbox" name="active" value="1"
            {{#if property.active}}checked{{/if}}>
            Active
    </label>
    </div>

    <!--Image field -->
    <label for="imageName"> Photo (optional)</label>
        {{#if property.imageName}}
        <img src="/houses/{{property.imageName}}" alt="Current Photo">
        {{/if}}
        <input type="file" id="imageName" name="imageName" 
        accept="image/jpeg, image/png, image/webp" class="pt-3 pb-1">
        <p class="text-gray-400">JPG, PNG or WebP, up to 2MB </p>

    <div class="text-white pt-4">
        <!--Submit button -->
        <button type="submit" class=" bg-blue-500 px-4 py-3 m-2 rounded-md ml-0"
            >Save Property</button>
            <!--Cancel button link -->
        <a href="/admin/properties" class=" bg-gray-500 px-4 py-3 m-2 rounded-md ml-0">Cancel</a>
    </div>

</form>
</div>
</div>